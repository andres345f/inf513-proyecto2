APP_NAME=FEDER
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=America/La_Paz
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# Configuración de registro para desarrollo local.
LOG_LEVEL=debug

# PostgreSQL local. Cree una base vacía y un usuario propio para esta instalación.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=feder_p2_demo
DB_USERNAME=feder_demo
DB_PASSWORD=
# Zona horaria de la sesión PostgreSQL (SET TIME ZONE al conectar): fechas y horas de Bolivia aunque el
# servidor de base de datos esté en otra zona. Compruébela con: SHOW timezone;
DB_TIMEZONE=America/La_Paz

# Proxy inverso que termina HTTPS delante de Apache (IP o lista separada por comas). Vacío: ninguno.
TRUSTED_PROXIES=

# Cero cambios de esquema: Laravel no usa tablas propias (sesiones, caché y colas sin base de datos).
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log

# FEDER Web
FEDER_SESION_HORAS=8
FEDER_CORREO_SISTEMA=sistema@feder.example
FEDER_SPA_INDEX=app/index.html
# Activar manualmente solo durante una demostración académica controlada.
FEDER_QR_SIMULADO=false

# OpenRouteService (distancia por calles). La clave nunca se sube al repositorio.
ORS_URL=https://api.openrouteservice.org
ORS_API_KEY=
